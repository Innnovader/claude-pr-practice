# Supabase (usar la service_role key — NUNCA la anon key aquí; este
# servicio necesita bypassear RLS para escribir contenido scrapeado)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — clasificación de sentimiento/NER/resúmenes
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# X (Twitter) API v2 — recent search / filtered stream
X_BEARER_TOKEN=

# Tavily — alternativa a la API de X si no hay acceso directo
TAVILY_API_KEY=

# Scheduler
SCRAPE_INTERVAL_MINUTES=10
DEDUP_SIMILARITY_THRESHOLD=0.92
